# Secrets. .env.example is the only env file that belongs in the repo.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# uv and virtualenvs. uv.lock is committed on purpose for reproducible CI.
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Local model and data artifacts (P1)
*.gguf
*.safetensors
models/
data/

# Vendored docs corpus and batch payloads. Cloned on demand, never committed.
# training/artifacts/ IS committed: manifest, dataset, golden set, spend ledger.
training/.scratch/

# Terraform (P2)
# .terraform.lock.hcl IS committed on purpose: it is the provider version pin.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
# Capacity retry logs. Machine-local run history, not project state; the
# measured attempt count and elapsed time go in DECISIONS.md instead.
infra/terraform/logs/

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp
