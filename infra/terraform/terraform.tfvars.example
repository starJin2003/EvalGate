# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
#
# No secrets belong in this file. Credentials live in ~/.oci/config, written by
# `oci setup config`, and the provider reads them from there. OCIDs are
# identifiers, not secrets.

# --- Required ---------------------------------------------------------------

# Console: profile menu (top right), then the tenancy name row, then OCID.
tenancy_ocid = "ocid1.tenancy.oc1..aaaaaaaa_REPLACE_ME"

# --- Optional, defaults are correct for this project ------------------------

# Leave empty to launch into the root compartment (same OCID as the tenancy).
# Otherwise: Identity & Security, then Compartments, then the compartment OCID.
# compartment_ocid = "ocid1.compartment.oc1..aaaaaaaa_REPLACE_ME"

# region = "us-chicago-1"
# oci_config_profile = "DEFAULT"

# The existing VCN and public subnet are looked up by name, never created.
# vcn_display_name = "evalgate-vcn"

# Leave empty to auto-select the first subnet in the VCN that permits public
# IPs. Set it if the VCN has more than one public subnet. Copy the name
# verbatim from the console, spaces included.
# public_subnet_display_name = "public subnet-evalgate-vcn"

# REQUIRED. Gates SSH (port 22) and nothing else. A validation rule rejects
# 0.0.0.0/0, so this must be a deliberate choice.
#   curl -s https://checkip.amazonaws.com
#
# There is no ingress rule for the k3s API on 6443 at all; kubectl reaches it
# through an SSH tunnel. See `terraform output kubectl_tunnel_command`.
#
# If your address changes you are NOT locked out. Edit the port 22 rule on the
# evalgate-k3s-nsg security group in the OCI console from any browser, then
# update this value so terraform stops reverting it. Full path in README.md.
admin_cidr = "203.0.113.4/32"

# Ports 80 and 443. Separate from admin_cidr on purpose so the two can never
# move together. Public by design: from P3 the eval gate is called by GitHub
# Actions runners, whose egress addresses cannot be usefully allowlisted.
# public_ingress_cidr = "0.0.0.0/0"

# Extra SANs for the k3s API certificate. Empty is correct while the API is
# reachable only through an SSH tunnel; k3s always includes 127.0.0.1. Do not
# reintroduce a boot-time public IP lookup: OCI's metadata service does not
# expose one. See README.md.
# extra_tls_sans = ["203.0.113.9"]

# Project-scoped by default so this stack neither depends on nor claims the
# machine's default identity. Generate it with:
#   ssh-keygen -t ed25519 -f ~/.ssh/evalgate_ed25519 -N "" -C "evalgate-oci-k3s"
# ssh_public_key_path = "~/.ssh/evalgate_ed25519.pub"

# Pin k3s after the first successful boot so a rebuild is reproducible.
# Read the installed version with: ssh ubuntu@<ip> 'k3s --version'
# k3s_version = "v1.33.4+k3s1"

# --- Shape ------------------------------------------------------------------
#
# 4 OCPU / 24 GB is the Always Free allowance on a PAYG tenancy and what this
# project is sized for. Do NOT lower these to make a capacity error go away.
# Out-of-capacity means the AD has no A1 hardware free right now; it is not a
# signal that the request is too large, and retry-apply.sh exists precisely so
# that waiting, rather than shrinking, is the response.
#
# Dropping to 2 OCPU is the documented BUILD_PLAN.md P2 contingency. It is a
# DECISION POINT: confirm with a human, log it in DECISIONS.md, and re-run the
# wrapper with --allow-downsize. Kafka sizing in P4 depends on this number.
#
# ocpus         = 4
# memory_in_gbs = 24
# boot_volume_size_in_gbs = 50
