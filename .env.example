# Copy to .env and fill in. .env is gitignored and never committed.
# In CI these come from GitHub Actions secrets; on OCI they come from Kubernetes secrets.

# --- Postgres (P0) -----------------------------------------------------------
# Consumed by docker-compose.dev.yml. Dev-only values; do not reuse in prod.
POSTGRES_USER=evalgate
POSTGRES_PASSWORD=evalgate
POSTGRES_DB=evalgate
# Set this to 5433 (and match DATABASE_URL) if a native Postgres already owns
# 5432 on your machine; a host-level listener shadows the container's mapping.
POSTGRES_PORT=5432

DATABASE_URL=postgresql://evalgate:evalgate@localhost:5432/evalgate

# --- OpenAI (P1) -------------------------------------------------------------
# Teacher generation, corpus embeddings, and the P1.4 judge all use this key.
# Teacher is gpt-5-mini; the judge must be a different model (see
# training/src/evalgate_training/config.py).
OPENAI_API_KEY=

# Hard spend ceilings for the P1.1 pipeline. The scripts halt when either is
# crossed; they do not warn and continue. Raise these only deliberately.
OPENAI_USD_CEILING=5.00
OPENAI_TOKEN_CEILING=30000000

# --- Fallback provider (P1) --------------------------------------------------
# Google AI Studio key. Fallback only; free-tier limits vary per project and are
# not the plan. See BUILD_PLAN.md section 11.
GEMINI_API_KEY=
# Hugging Face read/write token for base model download and adapter upload.
HF_TOKEN=
